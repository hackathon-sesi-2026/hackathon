# Copie para .env e ajuste. Todos os valores abaixo são os padrões de desenvolvimento.
SELO_URL_BANCO=postgresql://selo:selo@localhost:5433/selo_saude
# Conexão direta (sem pooler) usada só para o LISTEN do tempo real. Vazio = usa SELO_URL_BANCO.
SELO_URL_BANCO_ESCUTA=
SELO_ORIGENS_PERMITIDAS=["http://localhost:5173"]
# Liga as rotas /api/demonstracao e o seed de dados fictícios na subida.
SELO_MODO_DEMONSTRACAO=true
SELO_FUSO=America/Bahia

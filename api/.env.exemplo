# Copie para .env e ajuste. Os valores abaixo são os de desenvolvimento; o que muda na VPS está comentado.
# O .env nunca vai para o Git (api/.gitignore). Na VPS, ele fica só no servidor.

# Postgres. Na VPS, use o banco que já está instalado lá, ex.: postgresql://selo:SENHA@127.0.0.1:5432/selo_saude
SELO_URL_BANCO=postgresql://selo:selo@localhost:5433/selo_saude
# Conexão direta (sem pooler) usada só para o LISTEN do tempo real. Vazio = usa SELO_URL_BANCO.
SELO_URL_BANCO_ESCUTA=

# Quem pode chamar a API pelo navegador. Com o repasse /api da Vercel (web/vercel.json) o navegador fala só com
# a Vercel e isto nem é usado. Deixe o endereço do front, por segurança.
SELO_ORIGENS_PERMITIDAS=["http://localhost:5173"]
# Endereço do front que o celular abre: vai no link das mensagens do WhatsApp. Em produção: https://selosaude.vercel.app
SELO_URL_PUBLICA=http://localhost:5173

# Liga as rotas /api/demonstracao e o seed de dados fictícios na subida (10.303 pacientes, uns 30 segundos).
SELO_MODO_DEMONSTRACAO=true
SELO_FUSO=America/Bahia

# WhatsApp: "simulado" (nada sai de verdade) ou "megaapi" (envio real; ver docs/whatsapp.md).
SELO_WHATSAPP=simulado
SELO_MEGAAPI_URL=https://apistart01.megaapi.com.br
SELO_MEGAAPI_INSTANCIA=
SELO_MEGAAPI_TOKEN=
# Toda mensagem real vai para este número (DDI + DDD + número, só dígitos). Os trabalhadores são fictícios.
SELO_MEGAAPI_NUMERO_TESTE=

# WhatsApp da equipe de saúde, para o botão "Falar com a equipe" do app (só dígitos). Vazio: o botão só registra
# o pedido de contato, que a enfermeira vê como "pediu ajuda" no painel.
SELO_WHATSAPP_EQUIPE=
